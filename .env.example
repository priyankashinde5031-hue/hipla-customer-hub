# Copy this file to .env.local and fill in real values from your Supabase
# project. Never commit .env.local — it's already in .gitignore.

# Settings -> API in your Supabase project dashboard:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings -> API -> Project API keys -> service_role. Server-side only,
# never exposed to the browser, never prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
